"Title" = "Altnivelaj agordoj";
"TurnOff" = "Malŝalti";
"TurnOffDescription" = "Provizore ignori ĉiujn novajn kopiojn.\nVi verŝajne uzos tion en programo kaj malŝaltos la aplikaĵon dum kopiado de tiklaj datumoj.";
"TurnOffShellScript" = "defaults write com.gitswift.MaccyPaste ignoreEvents true\n# kopii datumojn\ndefaults write com.gitswift.MaccyPaste ignoreEvents false";
"TurnOffViaMenuIconDescription" = "Vi ankaŭ povas alklaki la menuan piktogramon dum ⌥ estas premata.\nPor ignori nur la sekvan kopion, alklaku kun ⌥⇧.";
"TurnOffNextShellScript" = "defaults write com.gitswift.MaccyPaste ignoreEvents true\ndefaults write com.gitswift.MaccyPaste ignoreOnlyNextEvent true\n# kopii datumojn";
"ClearHistoryOnQuit" = "Forigi la historion dum forlaso";
"ClearHistoryOnQuitTooltip" = "Aŭtomate forigi ĉiujn nefiksitajn erojn antaŭ ol forlasi la aplikaĵon.";
"ClearSystemClipboard" = "Forigi ankaŭ la sisteman tondujon";
"ClearSystemClipboardTooltip" = "Kiam ŝaltita, forigo de la historio ankaŭ forigus la nunan sisteman tondujon.";
