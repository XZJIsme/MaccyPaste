"Title" = "پیشرفته";
"TurnOff" = "خاموش کردن";
"TurnOffDescription" = "برای مدتی همهٔ کپی‌های جدید را نادیده بگیرید.\nاحتمالاً این گزینه را به‌صورت برنامه‌نویسی استفاده می‌کنید و برنامه را هنگام کپی کردن داده‌های حساس غیرفعال می‌کنید.";
"TurnOffShellScript" = "defaults write com.gitswift.MaccyPaste ignoreEvents true\n# داده‌ها را کپی کنید\ndefaults write com.gitswift.MaccyPaste ignoreEvents false";
"TurnOffViaMenuIconDescription" = "همچنین می‌توانید با نگه داشتن کلید ⌥ روی آیکون منو کلیک کنید.\nبرای نادیده گرفتن فقط کپی بعدی، با نگه داشتن ⌥⇧ کلیک کنید.";
"TurnOffNextShellScript" = "defaults write com.gitswift.MaccyPaste ignoreEvents true\ndefaults write com.gitswift.MaccyPaste ignoreOnlyNextEvent true\n# داده‌ها را کپی کنید";
